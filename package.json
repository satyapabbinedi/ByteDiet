{
  "name": "media-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-ffmpeg-core.mjs",
    "predev": "node scripts/sync-ffmpeg-core.mjs",
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "prebuild": "node scripts/sync-ffmpeg-core.mjs",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/ts-alias-loader.mjs --test scripts/media-api.test.mjs scripts/duration.test.mjs scripts/media-preview.test.mjs scripts/heic-sniff.test.mjs scripts/video-encoding.test.mjs",
    "db:verify": "node scripts/db-tool.mjs verify",
    "db:reset": "node scripts/db-tool.mjs reset",
    "fixtures": "node scripts/download-fixtures.mjs",
    "check": "npm run typecheck && npm test && npm run db:verify"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/webp": "1.5.0",
    "@mediabunny/aac-encoder": "1.65.2",
    "libheif-js": "^1.23.5",
    "mediabunny": "1.65.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "description": "Local-first Next.js PoC: browser-side image/video conversion and compression (incl. HEIC), stored in a git-friendly local DB."
}
